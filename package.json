{
  "name": "@coschedule/ember-froala-editor",
  "version": "2.0.0",
  "description": "An ember-cli addon that properly wraps the Froala WYSIWYG Editor for use in Ember.js",
  "keywords": [
    "ember-addon",
    "froala",
    "froala-editor",
    "froala-wysiwyg",
    "froala-wysiwyg-editor",
    "html",
    "rich",
    "text",
    "editor",
    "wysiwyg"
  ],
  "repository": "github:froala/ember-froala-editor",
  "homepage": "http://www.emberwysiwygeditor.com/",
  "bugs": "https://github.com/froala/ember-froala-editor/issues",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "contributors": [
    "Ryan Panning",
    "Stefan Neculai",
    "Michael Donaldson",
    "Diana Neculai",
    "Laura Lebovic",
    "Richard Livsey",
    "Raphael Nunes dos Santos",
    "Keita Urashima"
  ],
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@ember/render-modifiers": "^4.0.0",
    "@glimmer/component": "^1.1.2 || ^2.0.0",
    "ember-auto-import": "^2.13.1",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-version-checker": "^5.1.2",
    "froala-editor": "4.5.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@eslint/js": "^9.39.5",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.2.4",
    "ember-cli": "~7.3.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^3.0.1",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^6.1.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^15.15.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "webpack": "^5.111.0"
  },
  "peerDependencies": {
    "ember-source": ">= 3.28.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "demoURL": "http://www.emberwysiwygeditor.com/",
    "versionCompatibility": {
      "ember": ">=3.28.0"
    }
  },
  "ember-engines": {
    "addon": true
  }
}
